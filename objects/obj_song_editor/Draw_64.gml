if (note_editor) {
	draw_set_halign(fa_center)
	draw_text(640/4,8,"Player")
	draw_text(640*3/4,8,"Enemy")
	draw_set_halign(fa_left)
	var yy = 64
	draw_sprite_ext(spr_arrow_goal,0,640/4-32-64,yy,1,1,180,c_white,1)
	draw_sprite_ext(spr_arrow_goal,0,640/4-32,yy,1,1,270,c_white,1)
	draw_sprite_ext(spr_arrow_goal,0,640/4+32,yy,1,1,90,c_white,1)
	draw_sprite_ext(spr_arrow_goal,0,640/4+32+64,yy,1,1,0,c_white,1)

	draw_sprite_ext(spr_arrow_goal,0,640*3/4-32-64,yy,1,1,180,c_white,1)
	draw_sprite_ext(spr_arrow_goal,0,640*3/4-32,yy,1,1,270,c_white,1)
	draw_sprite_ext(spr_arrow_goal,0,640*3/4+32,yy,1,1,90,c_white,1)
	draw_sprite_ext(spr_arrow_goal,0,640*3/4+32+64,yy,1,1,0,c_white,1)
	var plr_surf = surface_create(64*4,480-96)
	surface_set_target(plr_surf)
	draw_line(1,0,0,480-96)
	draw_line(64,0,64,480-96)
	draw_line(64*2,0,64*2,480-96)
	draw_line(64*3,0,64*3,480-96)
	draw_line(64*4,0,64*4,480-96)
	draw_line_width(0,1-scroll,64*4,1-scroll,3)
	draw_set_alpha(0.75)
	for (var i = (64-scroll)%64; i <= (480-96); i += 64) {
		draw_line(0,i,64*4,i)
	}
	draw_set_alpha(1)
	surface_reset_target()
	draw_surface(plr_surf,640/4-32-64-32,96)
	surface_free(plr_surf)
	var enemy_surf = surface_create(64*4,480-96)
	surface_set_target(enemy_surf)
	draw_line(1,0,0,480-96)
	draw_line(64,0,64,480-96)
	draw_line(64*2,0,64*2,480-96)
	draw_line(64*3,0,64*3,480-96)
	draw_line(64*4,0,64*4,480-96)
	draw_line_width(0,1-scroll,64*4,1-scroll,3)
	draw_set_alpha(0.75)
	for (var i = (64-scroll)%64; i <= (480-96); i += 64) {
		draw_line(0,i,64*4,i)
	}
	draw_set_alpha(1)
	surface_reset_target()
	draw_surface(enemy_surf,640*3/4-32-64-32,96)
	surface_free(enemy_surf)
} else {
	draw_set_valign(fa_middle)
	draw_rectangle(16,480/3-32-8,32,480/3-32+8,true)
	draw_text(32+8,480/3-32,$"Song: {global.edit_song.song}")
	draw_rectangle(16,480/3-8,32,480/3+8,true)
	draw_text(32+8,480/3,$"Player voice: {global.edit_song.player_voice}")
	draw_rectangle(16,480/3+32-8,32,480/3+32+8,true)
	draw_text(32+8,480/3+32,$"Enemy voice: {global.edit_song.enemy_voice}")

	draw_rectangle(16,480*2/3-16-8,32,480*2/3-16+8,true)
	draw_text(32+8,480*2/3-16,$"Note speed: {global.edit_song.note_speed}")
	draw_rectangle(16,480*2/3+16-8,32,480*2/3+16+8,true)
	draw_text(32+8,480*2/3+16,"Note Editor")
	draw_set_valign(fa_top)
}